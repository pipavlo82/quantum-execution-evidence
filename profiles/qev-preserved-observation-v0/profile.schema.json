{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qev.dev/rvr/qev-preserved-observation-v0.profile.schema.json",
  "title": "RVR QEV profile constraints v0",
  "type": "object",
  "required": [
    "schema",
    "profileId",
    "profileSchemaContract",
    "verificationSpecification",
    "conformanceVectorSet",
    "evidenceSetContract",
    "canonicalResultContract",
    "externalContextPolicy"
  ],
  "properties": {
    "schema": {
      "const": "rvr.verification-profile.v0"
    },
    "profileId": {
      "const": "rvr-qev-preserved-observation-v0"
    },
    "profileSchemaContract": {
      "type": "object",
      "properties": {
        "manifest": {
          "type": "object",
          "properties": {
            "path": {
              "const": "vendor/rvr-v0/verification-profile-manifest.schema.json"
            },
            "requiredForRecomputation": {
              "const": true
            }
          }
        },
        "constraints": {
          "type": "object",
          "properties": {
            "path": {
              "const": "profiles/qev-preserved-observation-v0/profile.schema.json"
            },
            "requiredForRecomputation": {
              "const": true
            }
          }
        }
      }
    },
    "verificationSpecification": {
      "type": "object",
      "properties": {
        "path": {
          "const": "docs/RVR_QEV_PROFILE_V0.md"
        },
        "requiredForRecomputation": {
          "const": true
        }
      }
    },
    "conformanceVectorSet": {
      "type": "object",
      "properties": {
        "id": {
          "const": "rvr-qev-v0-falsification-set"
        }
      }
    },
    "evidenceSetContract": {
      "type": "object",
      "properties": {
        "schemaPath": {
          "const": "profiles/qev-preserved-observation-v0/rvr-qev.schema.json"
        },
        "schemaPointer": {
          "const": "#/$defs/evidenceSet"
        },
        "digestRule": {
          "const": "sha256-utf8-rvr-canonical-json-v0-normalized-member-order"
        }
      }
    },
    "canonicalResultContract": {
      "type": "object",
      "properties": {
        "schemaPath": {
          "const": "profiles/qev-preserved-observation-v0/rvr-qev.schema.json"
        },
        "schemaPointer": {
          "const": "#/$defs/canonicalResult"
        },
        "outcomeProjection": {
          "const": "/outcome"
        },
        "reasonCodeProjection": {
          "const": "/reasonCode"
        }
      }
    },
    "externalContextPolicy": {
      "type": "object",
      "properties": {
        "mode": {
          "const": "FORBIDDEN_UNLESS_COMMITTED"
        },
        "ambientInputs": {
          "const": "FORBIDDEN"
        },
        "immutableCommitments": {
          "type": "array",
          "maxItems": 0
        }
      }
    }
  }
}
