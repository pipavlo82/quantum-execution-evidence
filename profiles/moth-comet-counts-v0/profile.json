{
  "profileId": "qev-moth-comet-counts-v0",
  "schema": "qev.moth-comet-profile.v0",
  "input": "Preserved HTTP bodies and local unsigned independent claim",
  "entrypoint": "python -B -m qev.moth_replay",
  "specification": "docs/MOTH_COMET_COUNTS_V0.md",
